{
  "name": "agent-cfml-check",
  "version": "0.1.0",
  "description": "Deterministic, read-only structural checks for a bounded CFML subset.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "bin": {
    "agent-cfml-check": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "SPEC.md",
    "schema",
    "fixtures"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test .test-dist/test/check.test.js .test-dist/test/cli.test.js .test-dist/test/package.test.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
